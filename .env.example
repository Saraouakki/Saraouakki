# Jeton d'intégration Notion (Settings > Connections > Develop or manage integrations)
# Créez une intégration interne sur https://www.notion.so/my-integrations,
# puis partagez la page "Logistique & Transit — Plateforme" avec cette intégration.
NOTION_TOKEN=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Secret utilisé pour signer les sessions de connexion (JWT). Générez une valeur
# aléatoire, par exemple avec: openssl rand -base64 32
AUTH_SECRET=changez-moi-avec-une-valeur-aleatoire-longue

# IDs des data sources Notion (pré-remplis avec la base créée pour ce projet).
# Remplacez-les si vous dupliquez le workspace ou créez vos propres bases.
NOTION_DS_CLIENTS=63b5c2aa-1f91-4ee3-af38-546251cc9512
NOTION_DS_TRANSPORTEURS=13b56b2b-8702-48f3-a9a0-c161d164ea2f
NOTION_DS_ENTREPOTS=1064ddb2-c017-4f25-9bd5-a0611b9b8685
NOTION_DS_VEHICULES=aa39e5ce-318e-4cdc-b7e2-91975c4ca3ce
NOTION_DS_ARTICLES=56a1d6d7-b1c4-469e-a1f5-32b6365724b9
NOTION_DS_CHAUFFEURS=f379d360-2539-4425-93ea-c4a3ed60bcd1
NOTION_DS_DOSSIERS=75681d94-cdd7-4128-9719-6efac0680891
NOTION_DS_DOCUMENTS=52bac00c-6816-4bce-aed2-ac94885c0648
NOTION_DS_MOUVEMENTS=6ef7a3bb-5f2c-4cf4-8158-c88a5aaf82a2
NOTION_DS_ETAPES=032fb33d-eb93-49f0-b8cc-6ae88a5f9f08
NOTION_DS_FOURNISSEURS=0b7bcd5e-dcf5-41cf-803c-4c5778fbc744
NOTION_DS_UTILISATEURS=fc1ca633-5caf-43ca-a474-be4d96633b92
NOTION_DS_AUDIT=6f4dd67e-fd8d-4bee-975f-5db9c8d2aacf

# --- Fonctionnalités optionnelles (l'app fonctionne sans, en mode dégradé) --------

# Rate-limiting distribué (recommandé en production multi-instance). Créez une base
# Redis gratuite sur https://upstash.com — sans ces variables, un limiteur en mémoire
# locale est utilisé automatiquement (suffisant pour une seule instance).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Envoi d'e-mails (mot de passe oublié, notifications de statut, validation de compte).
# Sans configuration, les e-mails sont simplement journalisés dans la console (utile en
# dev). Renseignez soit un SMTP classique, soit une clé Resend (https://resend.com).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Logistique & Transit <no-reply@votre-domaine.com>"
RESEND_API_KEY=

# Notification Slack sur changement de statut de dossier (URL de webhook entrant).
SLACK_WEBHOOK_URL=

# Notification WhatsApp au client sur changement de statut (via Twilio WhatsApp API,
# https://www.twilio.com/whatsapp). Sans ces variables, le message est journalisé en
# console. TWILIO_WHATSAPP_FROM est le numéro expéditeur fourni par Twilio
# (ex: whatsapp:+14155238886 pour le sandbox de test).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# Surveillance d'erreurs (https://sentry.io) — désactivée si absente.
SENTRY_DSN=

# URL publique de l'application (utilisée dans les liens des e-mails envoyés).
APP_URL=http://localhost:3000

# E-mail de l'équipe interne notifié des nouvelles demandes d'inscription (signup).
# Laissez vide pour vérifier manuellement la page /comptes à la place.
ADMIN_NOTIFICATION_EMAIL=

# Durée de vie du cache en mémoire pour les lectures Notion, en millisecondes.
CACHE_TTL_MS=20000
