# Om Ritaj backend — environment variables
# Copy this file to `.env` and fill in real values.
# On Hostinger, set these instead via hPanel → Node.js App → "Environment Variables"
# (do not upload a real .env file to a shared/public path).

PORT=3000
NODE_ENV=production

# ---- Brand ----
OMRITAJ_SUPPORT_CONTACT=https://www.instagram.com/omritaj28

# ---- Twilio (SMS / WhatsApp OTP) ----
# Leave blank to run in mock mode (codes are logged to the server console instead of sent).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Preferred: create a Verify Service in the Twilio console and paste its SID here.
TWILIO_VERIFY_SERVICE_SID=
# Fallback only (used if TWILIO_VERIFY_SERVICE_SID is not set): WhatsApp Business sender number, e.g. +2126XXXXXXXX
TWILIO_WHATSAPP_FROM=

# ---- Google Sheets order log ----
GOOGLE_SHEETS_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the private key from your service account JSON, keeping \n escapes as literal text.
GOOGLE_PRIVATE_KEY=

# ---- 3PL / Fulfillment webhook (e.g. Amana, Speedaf, CTM) ----
THREEPL_WEBHOOK_URL=
THREEPL_API_KEY=
