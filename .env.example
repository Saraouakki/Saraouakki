# Jeton d'intégration Notion (Settings > Connections > Develop or manage integrations)
# Créez une intégration interne sur https://www.notion.so/my-integrations,
# puis partagez la page "Logistique & Transit — Plateforme" avec cette intégration.
NOTION_TOKEN=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Secret utilisé pour signer les sessions de connexion (JWT). Générez une valeur
# aléatoire, par exemple avec: openssl rand -base64 32
AUTH_SECRET=changez-moi-avec-une-valeur-aleatoire-longue

# IDs des data sources Notion (pré-remplis avec la base créée pour ce projet).
# Remplacez-les si vous dupliquez le workspace ou créez vos propres bases.
NOTION_DS_CLIENTS=63b5c2aa-1f91-4ee3-af38-546251cc9512
NOTION_DS_TRANSPORTEURS=13b56b2b-8702-48f3-a9a0-c161d164ea2f
NOTION_DS_ENTREPOTS=1064ddb2-c017-4f25-9bd5-a0611b9b8685
NOTION_DS_VEHICULES=aa39e5ce-318e-4cdc-b7e2-91975c4ca3ce
NOTION_DS_ARTICLES=56a1d6d7-b1c4-469e-a1f5-32b6365724b9
NOTION_DS_CHAUFFEURS=f379d360-2539-4425-93ea-c4a3ed60bcd1
NOTION_DS_DOSSIERS=75681d94-cdd7-4128-9719-6efac0680891
NOTION_DS_DOCUMENTS=52bac00c-6816-4bce-aed2-ac94885c0648
NOTION_DS_MOUVEMENTS=6ef7a3bb-5f2c-4cf4-8158-c88a5aaf82a2
